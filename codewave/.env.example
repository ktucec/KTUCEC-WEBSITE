# CODEWAVE 2026 — Shopier ödeme entegrasyonu (yalnızca sunucuda okunur; NEXT_PUBLIC_ öneki KULLANMAYIN).
# Shopier paneli > Entegrasyonlar > Modül Yönetimi'nden alınır. İkisi de boşsa bilet satışı kapalı görünür.
SHOPIER_API_KEY=
SHOPIER_API_SECRET=
# Panelde birden fazla web sitesi tanımlıysa bu sitenin sırası (1-5). Varsayılan 1.
SHOPIER_WEBSITE_INDEX=1
# Panelde bu siteye tanımlanacak geri dönüş URL'si: https://codewave.ktucec.com/api/shopier/callback

# ktucec.com backend bağlantısı (öğrenci indirimi + bilet başvurularının kaydı). İkisi de boşsa bilet satışı kapalı görünür.
# Tarayıcının çağırdığı herkese açık API adresi (indirim modalı). Geliştirmede: http://localhost:5142
NEXT_PUBLIC_KTUCEC_API_URL=
# İsteğe bağlı: sunucu backend'e farklı bir adresten ulaşıyorsa (boşsa yukarıdaki kullanılır).
KTUCEC_API_URL=
# Backend appsettings'teki Codewave:InternalApiKey ile AYNI değer. Yalnızca sunucuda okunur; NEXT_PUBLIC_ öneki KULLANMAYIN.
CODEWAVE_INTERNAL_KEY=
